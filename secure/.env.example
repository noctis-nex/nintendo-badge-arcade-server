# Copy to .env and configure for your own infrastructure.
KERBEROS_PASSWORD=replace-with-server-kerberos-password
MONGO_URI=mongodb://127.0.0.1:27017/
DATABASE_URI=postgres://user:password@127.0.0.1:5432/database?sslmode=disable
PN_NBA_CONFIG_S3_PATH=badge-arcade/ds/1/data
PN_NBA_CONFIG_S3_ENDPOINT=https://s3.example.invalid
PN_NBA_CONFIG_S3_REGION=us-east-1
PN_NBA_CONFIG_S3_BUCKET=replace-with-bucket
PN_NBA_CONFIG_S3_ACCESS_KEY=replace-with-access-key
PN_NBA_CONFIG_S3_ACCESS_SECRET=replace-with-access-secret
