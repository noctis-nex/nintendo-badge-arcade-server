# Copy to .env and configure for your own infrastructure.
KERBEROS_PASSWORD=replace-with-server-kerberos-password
MONGO_URI=mongodb://127.0.0.1:27017/
SECURE_SERVER_LOCATION=127.0.0.1
SECURE_SERVER_PORT=59401
# Hex-encoded secret; must decode to at least 32 bytes.
PN_NEX_PASSWORD_SECRET=replace-with-at-least-64-hex-characters
